# 复制为 .env，并替换为本机 MySQL 的账号和密码。
MYSQL_DSN='root:your_mysql_password@tcp(127.0.0.1:3306)/go_tiktok?charset=utf8mb4&parseTime=True&loc=Local'

# 使用 openssl rand -hex 32 生成随机密钥，将结果填入单引号内。
JWT_SECRET=''

# Docker Compose 使用以下独立参数；MYSQL_DSN 用于本机 go run 开发。
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=go_tiktok
REDIS_PASSWORD=123456
RABBITMQ_USER=admin
RABBITMQ_PASS=password123
